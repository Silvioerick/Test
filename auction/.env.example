# Copie para .env e gere os valores. O compose lê .env automaticamente.
#
#   cp .env.example .env
#   sed -i "s|^ENCRYPTION_KEY=.*|ENCRYPTION_KEY=$(openssl rand -base64 32)|" .env
#   sed -i "s|^ADMIN_TOKEN=.*|ADMIN_TOKEN=$(openssl rand -hex 32)|" .env

# Chave mestra AES-256 que cifra as chaves de gateway no Postgres.
# openssl rand -base64 32
# PERDER ESTA CHAVE = recadastrar todas as chaves de pagamento no painel.
ENCRYPTION_KEY=

# Token do painel admin. Sem ele a API responde 503 (falha fechada).
# openssl rand -hex 32
ADMIN_TOKEN=

# ---------------------------------------------------------------------
# Daqui para baixo é tudo OPCIONAL: são apenas fallback.
# O lugar certo destes valores é o painel, em Configurações — ali eles
# ficam cifrados no banco e podem ser trocados sem redeploy. O que estiver
# salvo no painel SEMPRE ganha do que estiver aqui.
# ---------------------------------------------------------------------

# Webhooks de pagamento. Sem o segredo (aqui ou no painel), o webhook
# correspondente responde 503 e NÃO aceita nada — é proposital.
HUBPAY_WEBHOOK_SECRET=
ASAAS_WEBHOOK_TOKEN=
# Preencha quando confirmar o header exato no painel da Asaas.
ASAAS_TOKEN_HEADER=

# Webhook de ENTRADA de mensagens. Quem posta aqui dá lance no lugar de
# terceiros, então trate como segredo de verdade.
WHATSAPP_WEBHOOK_SECRET=

# Gateway de envio de WhatsApp (DigiGO). Vazio = modo log, nada é
# entregue de verdade.
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Prefixo do link de cadastro mandado ao vencedor.
REGISTER_URL=https://leiloes.digitalsac.io/cadastro/

# Versão do Postgres usada pelo compose. 16 é o piso testado; 18 é o
# padrão. O schema não usa nada acima de PG 12.
POSTGRES_VERSION=18

# Senha do Postgres do compose. O banco só escuta em 127.0.0.1, mas
# troque assim mesmo se a VPS tiver outras pessoas com acesso.
POSTGRES_PASSWORD=postgres

# ---------------------------------------------------------------------
# Deploy em VPS (só com docker-compose.proxy.yml)
# ---------------------------------------------------------------------

# Domínio que aponta (DNS A/AAAA) para a VPS. O Caddy emite e renova o
# certificado Let's Encrypt sozinho para ele.
AUCTION_DOMAIN=

# E-mail para os avisos de expiração de certificado.
ACME_EMAIL=

# Onde a API escuta no host. O padrão 127.0.0.1 é proposital: quem fala
# com a internet é o proxy, que termina o TLS. O token de admin viaja num
# header e em HTTP puro é lido por qualquer um no caminho.
# Só mude para 0.0.0.0:4000 se for pôr OUTRO proxy com TLS na frente.
API_BIND=127.0.0.1:4000
