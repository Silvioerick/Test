# HTTPS automático via Let's Encrypt. O Caddy cuida da emissão e da
# renovação do certificado sozinho — só precisa que AUCTION_DOMAIN aponte
# para esta máquina e que as portas 80 e 443 estejam abertas.
{
	email {$ACME_EMAIL}
}

{$AUCTION_DOMAIN} {
	encode gzip

	# Em rede interna (domínio .local, IP, sem alcance da internet) o
	# Let's Encrypt não consegue validar o domínio. Descomente a linha
	# abaixo para o Caddy emitir um certificado da CA interna dele: o
	# tráfego fica cifrado, mas o navegador avisa que não conhece a CA
	# (normal — importe a raiz em /data/caddy/pki se quiser sem aviso).
	# tls internal

	# A API e o painel são servidos pelo mesmo processo.
	reverse_proxy api:4000

	header {
		# O painel não é para ser embutido em outro site.
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		# Um ano de HSTS. Tire se ainda estiver testando com este domínio.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
	}

	log {
		output stdout
		format console
	}
}
